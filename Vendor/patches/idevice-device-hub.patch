+            peer: PeerDevice {
+                account_id: "account".into(),
+                alt_irk: vec![0x11; 16],
+                model: "iPhone19,1".into(),
+                name: "Test iPhone".into(),
+                remotepairing_udid: "00008140-test".into(),
+            },
+            pairing_identifier: "peer-identifier".into(),
+            long_term_public_key: [0x22; 32],
+        }
+    }

+/// Register a virtual keyboard while the media-stream auth gate remains open.
+async fn with_keyboard_stream<F>(
+    adapter: &mut AdapterHandle,
+    handshake: &mut RsdHandshake,
+    gesture: F,
+) where
+    F: for<'a> FnOnce(
+        &'a mut UniversalHidServiceClient<Box<dyn idevice::ReadWrite>>,
+        u64,
+    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = ()> + 'a>>,
+{
+    let mut session = match start_screen_media_stream(adapter, handshake, 1).await {
+        Ok(session) => session,
+        Err(error) => {
+            eprintln!("failed to start media stream (needed for keyboard auth gate): {error}");
+            return;
+        }
+    };
+    let _audio_udp = session.audio_udp;
+    let _video_udp = session.video_udp;
+    tokio::time::sleep(std::time::Duration::from_millis(300)).await;
+    match UniversalHidServiceClient::connect_rsd(adapter, handshake).await {
+        Ok(mut hid) => {
+            match hid
+                .create_keyboard_service(&KeyboardServiceConfiguration::default())
+                .await
+            {
+                Ok(service_id) => {
+                    tokio::time::sleep(std::time::Duration::from_millis(300)).await;
+                    gesture(&mut hid, service_id).await;
+                    if let Err(error) = hid.cancel_keyboard(service_id, None).await {
+                        eprintln!("keyboard cleanup failed: {error:?}");
+                    }
+                }
+                Err(error) => eprintln!("unable to create virtual keyboard: {error:?}"),
+            }
+        }
+        Err(error) => eprintln!("no hid.universalhidservice: {error:?}"),
+    }
+    if let Err(error) = session.client.stop_media_stream().await {
+        eprintln!("stop_media_stream failed: {error:?}");
+    }
+}

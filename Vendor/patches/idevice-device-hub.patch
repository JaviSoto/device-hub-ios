+/// Parses a unique Content-Length value and rejects ambiguous framing.
+fn parse_content_length(headers: &[(String, String)]) -> Result<Option<usize>, IdeviceError> {
+    let mut parsed = None;
+    for (_, value) in headers
+        .iter()
+        .filter(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+    {
+        let value = value.trim().parse::<usize>().map_err(|_| {
+            IdeviceError::Http("invalid or conflicting HTTP Content-Length header".into())
+        })?;
+        if parsed.is_some_and(|previous| previous != value) {
+            return Err(IdeviceError::Http(
+                "invalid or conflicting HTTP Content-Length header".into(),
+            ));
+        }
+        parsed = Some(value);
+    }
+    Ok(parsed)

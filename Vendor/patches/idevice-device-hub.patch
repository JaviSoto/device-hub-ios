+    async fn persistence_is_provisional_before_m6_and_committed_after() {
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let persistence_events = Arc::clone(&events);
+        let send_events = Arc::clone(&events);
+
+        persist_pairing_around_m6(
+            &verified_peer(),
+            &mut move |state, _| {
+                persistence_events.lock().unwrap().push(match state {
+                    PairRecordState::Provisional => "provisional",
+                    PairRecordState::Committed => "committed",
+                });
+                std::future::ready(Ok::<(), IdeviceError>(()))
+            },
+            move || {
+                send_events.lock().unwrap().push("m6");
+                std::future::ready(Ok::<(), IdeviceError>(()))
+            },
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(*events.lock().unwrap(), ["provisional", "m6", "committed"]);
+    }
+
+    #[tokio::test]
+    async fn failed_provisional_persistence_prevents_m6() {
+        let sent_m6 = Arc::new(AtomicBool::new(false));
+        let send_observer = Arc::clone(&sent_m6);
+
+        let error = persist_pairing_around_m6(
+            &verified_peer(),
+            &mut |_, _| {
+                std::future::ready(Err::<(), IdeviceError>(IdeviceError::InternalError(
+                    "simulated persistence failure".into(),
+                )))
+            },
+            move || {
+                send_observer.store(true, Ordering::Relaxed);
+                std::future::ready(Ok::<(), IdeviceError>(()))

+
+        fn with_initial_pending(
+            max_write: usize,
+            return_pending: bool,
+        ) -> (Self, Arc<Mutex<AdversarialWriterState>>) {
+            let state = Arc::new(Mutex::new(AdversarialWriterState::default()));
+            (
+                Self {
+                    state: Arc::clone(&state),
+                    max_write,
+                    return_pending,
+                    return_flush_pending: true,
+                    return_shutdown_pending: true,

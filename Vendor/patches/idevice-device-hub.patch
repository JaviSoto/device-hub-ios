+    #[derive(Debug)]
+    struct ChunkedReader {
+        bytes: Vec<u8>,
+        position: usize,
+        max_read: usize,
+        fail_at: Option<usize>,
+        max_requested: usize,
+    }
+
+    impl ChunkedReader {
+        fn new(bytes: Vec<u8>, max_read: usize) -> Self {
+            Self {
+                bytes,
+                position: 0,
+                max_read,
+                fail_at: None,
+                max_requested: 0,
+            }
+        }
+
+        fn failing(bytes: Vec<u8>, max_read: usize, fail_at: usize) -> Self {
+            Self {
+                fail_at: Some(fail_at),
+                ..Self::new(bytes, max_read)
+            }
+        }
+    }
+
+    impl AsyncRead for ChunkedReader {
+        fn poll_read(
+            mut self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+            buffer: &mut ReadBuf<'_>,
+        ) -> Poll<io::Result<()>> {
+            self.max_requested = self.max_requested.max(buffer.remaining());
+            if self.fail_at.is_some_and(|fail_at| self.position >= fail_at) {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::ConnectionReset,
+                    "injected read failure",
+                )));
+            }
+            if self.position == self.bytes.len() {
+                return Poll::Ready(Ok(()));
+            }
+
+            let count = self
+                .max_read
+                .min(buffer.remaining())
+                .min(self.bytes.len() - self.position);
+            let end = self.position + count;
+            buffer.put_slice(&self.bytes[self.position..end]);
+            self.position = end;
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    #[derive(Debug)]
+    struct PartialWriter {
+        bytes: Vec<u8>,
+        max_write: usize,
+        fail_at: Option<usize>,
+    }
+
+    impl PartialWriter {
+        fn new(max_write: usize) -> Self {
+            Self {
+                bytes: Vec::new(),
+                max_write,
+                fail_at: None,
+            }
+        }
+
+        fn failing(max_write: usize, fail_at: usize) -> Self {
+            Self {
+                fail_at: Some(fail_at),
+                ..Self::new(max_write)
+            }
+        }
+    }
+
+    impl AsyncWrite for PartialWriter {
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+            bytes: &[u8],
+        ) -> Poll<io::Result<usize>> {
+            if self
+                .fail_at
+                .is_some_and(|fail_at| self.bytes.len() >= fail_at)
+            {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::BrokenPipe,
+                    "injected write failure",
+                )));
+            }
+
+            let remaining_before_failure = self
+                .fail_at
+                .map_or(usize::MAX, |fail_at| fail_at - self.bytes.len());
+            let count = bytes
+                .len()
+                .min(self.max_write)
+                .min(remaining_before_failure);
+            if count == 0 {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::WriteZero,
+                    "injected zero-length write",
+                )));
+            }
+            self.bytes.extend_from_slice(&bytes[..count]);
+            Poll::Ready(Ok(count))
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_shutdown(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    #[tokio::test]
